# ==============================================================================
# ATLAS.PAY Backend - Environment Configuration Template
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5001

# JWT Secret (generate a strong min-32-character secret)
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars-long

# Database Provider
# Use 'postgres' for Supabase PostgreSQL, or 'json' for local offline development
DB_PROVIDER=postgres

# Supabase Shared Transaction Pooler URI (Port 6543 recommended for Vercel Serverless)
# Format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-1-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.exampleprojectref:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres

# PostgreSQL Connection Pool Limit for Serverless (default 1 for Vercel Functions)
DB_POOL_MAX=1

# Cross-Service URLs (Set in Vercel Project Settings)
FRONTEND_URL=https://atlas-pay-frontend.vercel.app
PYTHON_SERVICE_URL=https://atlas-pay-intelligence.vercel.app
INTELLIGENCE_SERVICE_TIMEOUT_MS=3000

