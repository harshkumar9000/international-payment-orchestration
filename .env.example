# ==========================================
# ATLAS.PAY - International Payment Orchestration Platform
# Environment Configuration Template
# ==========================================

# -------------------------------------------------------------
# Node.js Express Orchestration Core (Port 5001)
# -------------------------------------------------------------
NODE_ENV=development
PORT=5001
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars-long
FRONTEND_URL=http://localhost:5173

# -------------------------------------------------------------
# Database Configuration (PostgreSQL / Supabase)
# -------------------------------------------------------------
# Example Supabase URI: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
# If omitted, ATLAS.PAY automatically activates its zero-config persistent embedded JSON store.
DATABASE_URL=

# -------------------------------------------------------------
# Python FastAPI Intelligence Microservice (Port 8000)
# -------------------------------------------------------------
PYTHON_SERVICE_URL=http://localhost:8000
INTELLIGENCE_SERVICE_TIMEOUT_MS=3000

# -------------------------------------------------------------
# Feature 1: Domestic Card & UPI Cross-Border Rails (NPCI / NIPL)
# -------------------------------------------------------------
ENABLE_RUPAY_GLOBAL_ROUTING=true
ENABLE_UPI_INTERNATIONAL_CORRIDORS=true
RBI_LRS_ANNUAL_CAP_USD=250000
DEFAULT_TCS_EDUCATION_PERCENT=5.0
DEFAULT_TCS_GENERAL_PERCENT=20.0

# -------------------------------------------------------------
# Feature 2: Under-18 & Student Payment Support
# -------------------------------------------------------------
STUDENT_AUTO_APPROVAL_THRESHOLD_USD=50.00
STUDENT_DEFAULT_MONTHLY_LIMIT_USD=500.00
REQUIRE_GUARDIAN_2FA_CONSENT=true

# -------------------------------------------------------------
# Feature 3: Agentic Refund & Payment Recovery
# -------------------------------------------------------------
ENABLE_AGENTIC_AUTO_REFUNDS=true
REFUND_COMPLIANCE_ESCALATION_THRESHOLD_USD=500.00
IDEMPOTENCY_KEY_PREFIX=idem_

# -------------------------------------------------------------
# Payment Gateways (Real Sandbox Credentials & Simulators)
# -------------------------------------------------------------
# 1. PayPal Sandbox (Real REST API integration when credentials provided)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# 2. Simulated Providers (Realistic latency, success SLAs, fee models, soft declines)
# Stripe, Adyen, Razorpay / UPI, dLocal
SIMULATE_GATEWAY_LATENCY=true

# -------------------------------------------------------------
# Frontend Configuration (Vite)
# -------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5001/api
VITE_PYTHON_SERVICE_URL=http://localhost:8000
