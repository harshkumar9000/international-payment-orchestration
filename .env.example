# ==========================================
# International Payment Orchestration Platform
# Environment Configuration Template
# ==========================================

# -----------------
# Node.js Backend Server
# -----------------
NODE_ENV=development
PORT=5001
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars-long
FRONTEND_URL=http://localhost:5173

# -----------------
# Database (PostgreSQL / Supabase)
# -----------------
# For Supabase / PostgreSQL: postgresql://postgres:password@host:5432/dbname
# If DATABASE_URL is not set or unreachable, the system automatically uses embedded fallback database.
DATABASE_URL=

# -----------------
# Python Intelligence Microservice (Fraud & Smart Routing)
# -----------------
PYTHON_SERVICE_URL=http://localhost:8000
INTELLIGENCE_SERVICE_TIMEOUT_MS=3000

# -----------------
# PayPal Sandbox Credentials (Optional)
# If provided, real PayPal Sandbox orders are created and processed.
# If omitted, intelligent sandbox simulation is used automatically.
# -----------------
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# -----------------
# Frontend Configuration (Vite)
# -----------------
VITE_API_BASE_URL=http://localhost:5001/api
VITE_PYTHON_SERVICE_URL=http://localhost:8000

