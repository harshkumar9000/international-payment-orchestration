# ==========================================
# ATLAS.PAY - International Payment Orchestration Platform
# Environment Configuration Template
# ==========================================

# -------------------------------------------------------------
# Node.js Express Orchestration Core (Port 5001)
# -------------------------------------------------------------
NODE_ENV=development
PORT=5001
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars-long
FRONTEND_URL=http://localhost:5173

# -------------------------------------------------------------
# Database Configuration (PostgreSQL / Supabase or Local JSON)
# -------------------------------------------------------------
# Select database provider:
#   DB_PROVIDER=postgres -> Connect to Supabase PostgreSQL (requires DATABASE_URL)
#   DB_PROVIDER=json     -> Use local embedded JSON database (zero external dependencies)
DB_PROVIDER=postgres

# Supabase PostgreSQL Session Pooler Connection String (Session Pooler recommended)
# Get this from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> Session (Port 5432)
# Format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-1-[region].pooler.supabase.com:5432/postgres
# Replace [YOUR-PASSWORD] with your actual Supabase database password.
DATABASE_URL=postgresql://postgres.exampleprojectref:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# -------------------------------------------------------------
# Python FastAPI Intelligence Microservice (Port 8000)
# -------------------------------------------------------------
PYTHON_SERVICE_URL=http://localhost:8000
INTELLIGENCE_SERVICE_TIMEOUT_MS=3000

# -------------------------------------------------------------
# Feature 1: Domestic Card & UPI Cross-Border Rails (NPCI / NIPL)
# -------------------------------------------------------------
ENABLE_RUPAY_GLOBAL_ROUTING=true
ENABLE_UPI_INTERNATIONAL_CORRIDORS=true
RBI_LRS_ANNUAL_CAP_USD=250000
DEFAULT_TCS_EDUCATION_PERCENT=5.0
DEFAULT_TCS_GENERAL_PERCENT=20.0

# -------------------------------------------------------------
# Feature 2: Under-18 & Student Payment Support
# -------------------------------------------------------------
STUDENT_AUTO_APPROVAL_THRESHOLD_USD=50.00
STUDENT_DEFAULT_MONTHLY_LIMIT_USD=500.00
REQUIRE_GUARDIAN_2FA_CONSENT=true

# -------------------------------------------------------------
# Feature 3: Agentic Refund & Payment Recovery
# -------------------------------------------------------------
ENABLE_AGENTIC_AUTO_REFUNDS=true
REFUND_COMPLIANCE_ESCALATION_THRESHOLD_USD=500.00
IDEMPOTENCY_KEY_PREFIX=idem_

# -------------------------------------------------------------
# Official PayPal Payment Gateway Integration (Orders API v2 & Webhooks)
# -------------------------------------------------------------
# Environment: 'sandbox' (default for testing) or 'live' (production)
PAYPAL_ENV=sandbox

# PayPal REST API Credentials (from developer.paypal.com -> Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# PayPal Webhook ID (from developer.paypal.com -> Apps & Credentials -> Webhooks)
# Used for cryptographic signature verification of incoming webhooks
PAYPAL_WEBHOOK_ID=

# Frontend PayPal Client ID (Safe for client-side JavaScript SDK)
# NEVER put PAYPAL_CLIENT_SECRET in client-facing variables!
VITE_PAYPAL_CLIENT_ID=

# -------------------------------------------------------------
# Simulated Providers (Realistic latency, success SLAs, fee models, soft declines)
# -------------------------------------------------------------
# Stripe, Adyen, Razorpay / UPI, dLocal
SIMULATE_GATEWAY_LATENCY=true

# -------------------------------------------------------------
# Frontend Configuration (Vite)
# -------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5001/api
VITE_PYTHON_SERVICE_URL=http://localhost:8000
